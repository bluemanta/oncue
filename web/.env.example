# 复制成 .env.local 后填入真实值。.env.local 不进版本库，也不要贴进聊天窗口。

# 腾讯云应用子账号 oncue-app 的密钥。
# 这个账号只能调大模型、语音合成、口语评测和指定的 COS 桶，碰不到服务器。
# 不要在这里放运维账号（imalltrix-ops）的密钥。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# LKEAP（知识引擎原子能力）。官方支持 ap-guangzhou 和 ap-shanghai。
# 可用模型：deepseek-v3 / deepseek-v3.1 / deepseek-r1。
# 不要用 deepseek-r1，它是推理模型，会拖慢到超出 10 秒。
LKEAP_REGION=ap-guangzhou
LKEAP_MODEL=deepseek-v3

# 生成结果卡片走哪个供应商。留空或 lkeap 走真接口；
# 设成 sample 用手写样本，断网或只想改界面时用。
CARD_PROVIDER=

# 语音合成。501009 是 WeWinny 外语女声，实听七个英文音色后选定的。
# 注意它属于「大模型音色」，走 10 万字符那档免费额度，不是通用音色的 800 万。
# 腾讯云目前没有英音音色（七个实听下来都是美音），所以界面上没有美/英切换，
# TTS_VOICE_UK 留空即可；将来有英音音色了再填，并把切换加回界面。
TTS_REGION=ap-shanghai
TTS_VOICE_US=501009
TTS_VOICE_UK=
# 慢速用的 Speed 值：-1 是 0.8 倍速，-2 是 0.6 倍速
TTS_SLOW_SPEED=-1

# 音频缓存桶。同一个词的读音只合成一次，之后从这里取。
COS_BUCKET=
COS_REGION=ap-shanghai

# 跟读评测的假结果开关。只在本地开发时设为 1，用来看三档反馈界面。
# 线上必须留空——假的发音反馈比没有反馈更糟。
NEXT_PUBLIC_MOCK_ASSESSMENT=
