# 复制成 .env.local 后填入真实值。.env.local 不进版本库，也不要贴进聊天窗口。

# 腾讯云应用子账号 oncue-app 的密钥。
# 这个账号只能调大模型、语音合成、口语评测和指定的 COS 桶，碰不到服务器。
# 不要在这里放运维账号（imalltrix-ops）的密钥。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# LKEAP（知识引擎原子能力）。官方支持 ap-guangzhou 和 ap-shanghai。
# 可用模型：deepseek-v3 / deepseek-v3.1 / deepseek-r1。
# 不要用 deepseek-r1，它是推理模型，会拖慢到超出 10 秒。
LKEAP_REGION=ap-guangzhou
LKEAP_MODEL=deepseek-v3

# 生成结果卡片走哪个供应商。留空或 lkeap 走真接口；
# 设成 sample 用手写样本，断网或只想改界面时用。
CARD_PROVIDER=
